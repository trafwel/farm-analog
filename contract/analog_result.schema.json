{
  "$defs": {
    "Analog": {
      "additionalProperties": false,
      "description": "One place whose climate today matches the farm's future climate.",
      "properties": {
        "climograph": {
          "anyOf": [
            {
              "$ref": "#/$defs/Climograph"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "crops": {
          "anyOf": [
            {
              "items": {
                "$ref": "#/$defs/CropShare"
              },
              "type": "array"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Crops"
        },
        "fingerprint": {
          "$ref": "#/$defs/SeasonalFingerprint"
        },
        "lat": {
          "maximum": 90,
          "minimum": -90,
          "title": "Lat",
          "type": "number"
        },
        "lon": {
          "maximum": 180,
          "minimum": -180,
          "title": "Lon",
          "type": "number"
        },
        "match_quality": {
          "enum": [
            "strong",
            "good",
            "weak",
            "none"
          ],
          "title": "Match Quality",
          "type": "string"
        },
        "models_agree": {
          "minimum": 0,
          "title": "Models Agree",
          "type": "integer"
        },
        "models_total": {
          "minimum": 1,
          "title": "Models Total",
          "type": "integer"
        },
        "place_name": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Place Name"
        },
        "rank": {
          "minimum": 1,
          "title": "Rank",
          "type": "integer"
        },
        "sigma": {
          "minimum": 0,
          "title": "Sigma",
          "type": "number"
        },
        "soil": {
          "anyOf": [
            {
              "$ref": "#/$defs/SoilProfile"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        }
      },
      "required": [
        "rank",
        "lon",
        "lat",
        "sigma",
        "match_quality",
        "models_agree",
        "models_total",
        "fingerprint"
      ],
      "title": "Analog",
      "type": "object"
    },
    "Climograph": {
      "additionalProperties": false,
      "description": "Data for the comparison chart: the farm today, the farm in the future, the analog today.",
      "properties": {
        "analog_today": {
          "$ref": "#/$defs/MonthlyClimate"
        },
        "farm_future": {
          "$ref": "#/$defs/MonthlyClimate"
        },
        "farm_today": {
          "$ref": "#/$defs/MonthlyClimate"
        }
      },
      "required": [
        "farm_today",
        "farm_future",
        "analog_today"
      ],
      "title": "Climograph",
      "type": "object"
    },
    "CropShare": {
      "additionalProperties": false,
      "properties": {
        "crop": {
          "title": "Crop",
          "type": "string"
        },
        "share": {
          "maximum": 1,
          "minimum": 0,
          "title": "Share",
          "type": "number"
        }
      },
      "required": [
        "crop",
        "share"
      ],
      "title": "CropShare",
      "type": "object"
    },
    "MonthlyClimate": {
      "additionalProperties": false,
      "description": "Twelve monthly values, January first: mean temperature in \u00b0C, precipitation in mm.",
      "properties": {
        "ppt": {
          "items": {
            "type": "number"
          },
          "maxItems": 12,
          "minItems": 12,
          "title": "Ppt",
          "type": "array"
        },
        "tmean": {
          "items": {
            "type": "number"
          },
          "maxItems": 12,
          "minItems": 12,
          "title": "Tmean",
          "type": "array"
        }
      },
      "required": [
        "tmean",
        "ppt"
      ],
      "title": "MonthlyClimate",
      "type": "object"
    },
    "SeasonalFingerprint": {
      "additionalProperties": false,
      "description": "The 8 climate values used for matching (definition in ``farm_analog.fingerprint``).\n\nFor each calendar quarter: average temperature (``tmean_``, the mean of the three monthly\nmean temperatures, \u00b0C) and total precipitation (``ppt_``, mm). Quarters: ``jfm`` =\nJan-Mar, ``amj`` = Apr-Jun, ``jas`` = Jul-Sep, ``ond`` = Oct-Dec.",
      "properties": {
        "ppt_amj": {
          "minimum": 0,
          "title": "Ppt Amj",
          "type": "number"
        },
        "ppt_jas": {
          "minimum": 0,
          "title": "Ppt Jas",
          "type": "number"
        },
        "ppt_jfm": {
          "minimum": 0,
          "title": "Ppt Jfm",
          "type": "number"
        },
        "ppt_ond": {
          "minimum": 0,
          "title": "Ppt Ond",
          "type": "number"
        },
        "tmean_amj": {
          "title": "Tmean Amj",
          "type": "number"
        },
        "tmean_jas": {
          "title": "Tmean Jas",
          "type": "number"
        },
        "tmean_jfm": {
          "title": "Tmean Jfm",
          "type": "number"
        },
        "tmean_ond": {
          "title": "Tmean Ond",
          "type": "number"
        }
      },
      "required": [
        "tmean_jfm",
        "tmean_amj",
        "tmean_jas",
        "tmean_ond",
        "ppt_jfm",
        "ppt_amj",
        "ppt_jas",
        "ppt_ond"
      ],
      "title": "SeasonalFingerprint",
      "type": "object"
    },
    "SoilProfile": {
      "additionalProperties": false,
      "description": "Soil summary; any value can be missing where the soil survey has no data.",
      "properties": {
        "available_water_capacity_cm": {
          "anyOf": [
            {
              "minimum": 0,
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Available Water Capacity Cm"
        },
        "clay_pct": {
          "anyOf": [
            {
              "maximum": 100,
              "minimum": 0,
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Clay Pct"
        },
        "depth_to_restrictive_layer_cm": {
          "anyOf": [
            {
              "minimum": 0,
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Depth To Restrictive Layer Cm"
        },
        "organic_matter_pct": {
          "anyOf": [
            {
              "maximum": 100,
              "minimum": 0,
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Organic Matter Pct"
        },
        "sand_pct": {
          "anyOf": [
            {
              "maximum": 100,
              "minimum": 0,
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Sand Pct"
        }
      },
      "title": "SoilProfile",
      "type": "object"
    }
  },
  "additionalProperties": false,
  "description": "Everything the app shows for one field.",
  "properties": {
    "analogs": {
      "items": {
        "$ref": "#/$defs/Analog"
      },
      "title": "Analogs",
      "type": "array"
    },
    "baseline_years": {
      "maxItems": 2,
      "minItems": 2,
      "prefixItems": [
        {
          "type": "integer"
        },
        {
          "type": "integer"
        }
      ],
      "title": "Baseline Years",
      "type": "array"
    },
    "farm_future": {
      "$ref": "#/$defs/SeasonalFingerprint"
    },
    "farm_soil": {
      "anyOf": [
        {
          "$ref": "#/$defs/SoilProfile"
        },
        {
          "type": "null"
        }
      ],
      "default": null
    },
    "farm_today": {
      "$ref": "#/$defs/SeasonalFingerprint"
    },
    "field_id": {
      "title": "Field Id",
      "type": "string"
    },
    "future_years": {
      "maxItems": 2,
      "minItems": 2,
      "prefixItems": [
        {
          "type": "integer"
        },
        {
          "type": "integer"
        }
      ],
      "title": "Future Years",
      "type": "array"
    },
    "models": {
      "items": {
        "type": "string"
      },
      "minItems": 1,
      "title": "Models",
      "type": "array"
    },
    "notes": {
      "items": {
        "type": "string"
      },
      "title": "Notes",
      "type": "array"
    },
    "novel_climate": {
      "title": "Novel Climate",
      "type": "boolean"
    },
    "scenario": {
      "enum": [
        "ssp245",
        "ssp585"
      ],
      "title": "Scenario",
      "type": "string"
    },
    "source": {
      "enum": [
        "computed",
        "fixture"
      ],
      "title": "Source",
      "type": "string"
    }
  },
  "required": [
    "source",
    "field_id",
    "scenario",
    "baseline_years",
    "future_years",
    "models",
    "farm_today",
    "farm_future",
    "novel_climate",
    "analogs"
  ],
  "title": "AnalogResult",
  "type": "object"
}
